{
  "name": "solarquote-ng",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-check.mjs",
    "check:catalog": "node scripts/catalog-check.mjs",
    "check:counter": "node scripts/counter-check.mjs",
    "check:pdf": "node --experimental-loader=./scripts/stubs/loader.mjs --no-warnings scripts/pdf-export-check.mjs",
    "check:edges": "node scripts/edge-cases.mjs",
    "check:billing": "node scripts/billing-check.mjs",
    "check:usercatalog": "node scripts/usercatalog-check.mjs",
    "logos:fetch": "node scripts/fetch-brand-logos.mjs",
    "logos:apply": "node scripts/apply-brand-logos.mjs",
    "check:font": "node scripts/font-check.mjs verify .tmp-font.bin",
    "check:render": "node scripts/render-check.mjs",
    "check:all": "npm run check:encoding && node scripts/smoke-check.mjs && node scripts/edge-cases.mjs && node scripts/catalog-check.mjs && node scripts/counter-check.mjs && node scripts/billing-check.mjs && node scripts/usercatalog-check.mjs && npm run check:diagnostic && npm run check:render",
    "check:diagnostic": "node scripts/diagnostic-probe.mjs",
    "check:encoding": "node scripts/encoding-audit.mjs",
    "fix:encoding": "node scripts/fix-encoding.mjs",
    "check:bundle": "node scripts/bundle-check.mjs"
  },
  "dependencies": {
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.1",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
