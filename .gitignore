# Source TTF for the embedded PDF font. The generated src/fonts/noto-sans.js is
# committed (it is what the app imports); the raw binary is not needed to build.
.tmp-font.bin

# Output of scripts/fetch-brand-logos.mjs. The logos themselves in public/brands/
# ARE committed; only this intermediate manifest is machine state.
.tmp-logo-manifest.json
.tmp-apk/

# visual audit artefacts (regenerated by npm run check:visual)
.tmp-shots/
.tmp-chrome*/

# CI upload keystore (generated in the workflow, never committed)
android/app/*.jks

# The full source TTFs. Only the subsetted copies in src/fonts ship.
assets/fonts-src/

# Scratch download of the upstream font
.tmp-font.bin

scripts/verify-encoding-repair.mjs
*.out
*.err
scripts/diag-*.mjs
.tmp-shots/
